# URL del proyecto de Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave pública: "anon" o "publishable" (sb_publishable_...). La API actúa siempre con el JWT del usuario (RLS).
SUPABASE_ANON_KEY=
# Orígenes permitidos para CORS, separados por comas ("*" para cualquiera)
CORS_ORIGIN=*
PORT=3000
