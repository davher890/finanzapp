# URL del proyecto de Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave pública: "anon" o "publishable" (sb_publishable_...). La API actúa siempre con el JWT del usuario (RLS).
SUPABASE_ANON_KEY=
# Orígenes permitidos para CORS, separados por comas ("*" para cualquiera)
CORS_ORIGIN=*
PORT=3000
# URL pública del front: a ella lleva el enlace del email de recuperar contraseña
# (si el front no envía la suya). Debe estar en Supabase → Authentication → URL Configuration.
APP_URL=https://finanzapp-app.vercel.app
